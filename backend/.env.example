# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# Find these in your Supabase project: Settings → API
# ---------------------------------------------------------------------------
# Public project URL — safe to expose to the frontend too
SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key — used to build a per-request client that respects RLS
# as the logged-in user. Safe to expose to the frontend.
SUPABASE_ANON_KEY=your-anon-key

# SECRET service-role key — bypasses Row Level Security. Server-side ONLY.
# Never commit this, never send it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Direct Database Connection (Optional — for running `npm run db:migrate`)
# Find in Supabase: Settings → Database → Connection string (URI)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
